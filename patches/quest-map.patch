+fn journal_effects(
+    mut fill: impl FnMut(f32, f32, f32, f32, u32),
+    center: (f32, f32),
+    radius: f32,
+    focused: bool,
+    seconds: f32,
+    completion_age: Option<f32>,
+) {
+    use std::f32::consts::{PI, TAU};
+
+    let burst = completion_age.filter(|t| (0.0..1.1).contains(t));
+    if !focused && burst.is_none() {
+        return;
+    }
+
+    let abgr = |r: u8, g: u8, b: u8, a: f32| -> u32 {
+        let a = (a.clamp(0.0, 1.0) * 255.0).round() as u32;
+        (a << 24) | ((b as u32) << 16) | ((g as u32) << 8) | (r as u32)
+    };
+
+    fn star(
+        fill: &mut impl FnMut(f32, f32, f32, f32, u32),
+        x: f32,
+        y: f32,
+        arm: f32,
+        stroke: u32,
+        core: u32,
+    ) {
+        fill(x - arm, y - 0.5, arm * 2.0, 1.0, stroke);
+        fill(x - 0.5, y - arm, 1.0, arm * 2.0, stroke);
+        fill(x - 0.5, y - 0.5, 1.0, 1.0, core);
+    }
+
+    let (cx, cy) = center;
+    if focused {
+        let pulse = 0.5 + 0.5 * (seconds * (TAU / 3.0)).sin();
+        let drift = seconds * 0.35;
+        let arc_r = radius + 2.0 + 0.5 * pulse;
+        for seg in 0..4 {
+            let base = drift + seg as f32 * (TAU * 0.25);
+            for i in 0..8 {
+                let u = (i as f32 + 0.5) / 8.0;
+                let taper = (u * PI).sin();
+                let (s, c) = (base + (u - 0.5) * 0.55).sin_cos();
+                let sz = if taper > 0.7 { 2.0 } else { 1.0 };
+                let col = abgr(255, 214, 106, (0.25 + 0.45 * pulse) * taper);
+                fill(
+                    cx + c * arc_r - sz * 0.5,
+                    cy + s * arc_r - sz * 0.5,
+                    sz,
+                    sz,
+                    col,
+                );
+            }
+        }
+        for g in 0..2 {
+            let tw = 0.5 + 0.5 * (seconds * (TAU / 3.0) + g as f32 * PI).sin();
+            let (s, c) = (drift * 1.4 + 0.7 + g as f32 * PI).sin_cos();
+            let r = radius + 2.5;
+            let (stroke, core) = (
+                abgr(255, 214, 106, 0.35 + 0.5 * tw),
+                abgr(255, 246, 210, 0.55 + 0.45 * tw),
+            );
+            star(
+                &mut fill,
+                cx + c * r,
+                cy + s * r,
+                1.5 + 1.5 * tw,
+                stroke,
+                core,
+            );
+        }
+    }
+
+    if let Some(age) = burst {
+        for i in 0..5 {
+            let local = age - i as f32 * 0.10;
+            if !(0.0..0.70).contains(&local) {
+                continue;
+            }
+            let p = local / 0.70;
+            let ease = 1.0 - (1.0 - p) * (1.0 - p);
+            let alpha = (0.25 + 0.75 * (p * 5.0).min(1.0)) * (1.0 - p);
+            let (s, c) = (-1.1 + i as f32 * (TAU / 5.0)).sin_cos();
+            let dist = radius + 3.0 + (6.0 + (i % 2) as f32 * 3.0) * ease;
+            let arm = (1.5 + 2.5 * (p * PI).sin()) * (1.0 - 0.3 * p);
+            let (r, g, b) = if i % 2 == 0 {
+                (255, 244, 204)
+            } else {
+                (255, 210, 96)
+            };
+            star(
+                &mut fill,
+                cx + c * dist,
