+//! Quest prerequisites on the primary output of player-operated crafting grids.
+use super::{Advancement, Progress, Tree};
+use horizon_world::loot::PackOverlay;
+use serde::Deserialize;
+use std::collections::HashMap;
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Rule {
+    version: u32,
+    action: String,
+    scope: String,
+    output: String,
+    requires: Requires,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Requires {
+    quest_completed: String,
+}
+
+#[derive(Default)]
+pub struct CraftingRules(HashMap<String, Vec<Advancement>>);
+
+fn resource_id(id: &str) -> bool {
+    let Some((ns, path)) = id.split_once(':') else {
+        return false;
+    };
+    let valid =
+        |b: u8| b.is_ascii_lowercase() || b.is_ascii_digit() || matches!(b, b'.' | b'_' | b'-');
+    !ns.is_empty()
+        && !ns.starts_with('.')
+        && ns.bytes().all(valid)
+        && path
+            .split('/')
+            .all(|part| !matches!(part, "" | "." | "..") && part.bytes().all(valid))
+}
+
+impl CraftingRules {
+    pub fn load(
+        overlay: &PackOverlay,
+        tree: &Tree,
+        item_exists: impl Fn(&str) -> bool,
+    ) -> Result<Self, (String, String)> {
+        let mut rules = Self::default();
+        let mut files: Vec<_> = overlay.kind("progression_rule").collect();
+        files.sort_by_key(|(id, _)| *id);
+        for (id, versions) in files {
+            let error = |why: &str| (id.to_owned(), why.to_owned());
+            if !resource_id(id) {
+                return Err(error("invalid resource ID"));
+            }
+            let rule: Rule = serde_json::from_slice(PackOverlay::top(versions))
+                .map_err(|e| error(&e.to_string()))?;
+            if (rule.version, rule.action.as_str(), rule.scope.as_str()) != (1, "craft", "player") {
+                return Err(error("expected version 1, action craft and scope player"));
+            }
+            if !resource_id(&rule.output) || !item_exists(&rule.output) {
+                return Err(error(&format!("unknown output {}", rule.output)));
+            }
+            let quest = &rule.requires.quest_completed;
+            if !resource_id(quest) {
+                return Err(error(&format!("invalid quest {quest}")));
+            }
+            let index = tree
+                .by_id
+                .get(quest)
+                .ok_or_else(|| error(&format!("unknown quest {quest}")))?;
+            rules
+                .0
+                .entry(rule.output)
+                .or_default()
+                .push(tree.list[*index].clone());
+        }
+        Ok(rules)
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.0.is_empty()
+    }
+
+    pub fn missing(&self, output: &str, player: &Progress) -> Option<&Advancement> {
+        self.0.get(output)?.iter().find(|quest| !player.done(quest))
+    }
+}
+
+pub type ActorRules<'a> = Option<(&'a CraftingRules, &'a Progress)>;
+pub fn missing<'a>(actor: ActorRules<'a>, output: &str) -> Option<&'a Advancement> {
+    let (rules, player) = actor?;
+    rules.missing(output, player)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    fn tree() -> Tree {
+        let mut tree = Tree::default();
+        for id in ["pack:a", "pack:b"] {
+            let quest = super::super::parse(
+                id,
+                &json!({"criteria":{"done":{"trigger":"minecraft:impossible"}}}),
+            )
+            .unwrap();
+            tree.by_id.insert(id.into(), tree.list.len());
+            tree.list.push(quest);
+        }
+        tree
+    }
+
+    fn rule(quest: &str) -> Vec<u8> {
+        json!({"version":1,"scope":"player","action":"craft","output":"minecraft:oak_planks",
+               "requires":{"quest_completed":quest}})
+        .to_string()
+        .into_bytes()
+    }
+
+    #[test]
+    fn quest_crafting_override_and_independent_players() {
+        let files = vec![
+            ("progression_rule/test:z".into(), vec![rule("pack:b")]),
+            (
+                "progression_rule/test:a".into(),
+                vec![rule("pack:removed"), rule("pack:a")],
+            ),
+        ];
+        let overlay = PackOverlay { files: &files };
+        let rules = CraftingRules::load(&overlay, &tree(), |_| true).unwrap();
+        let mut alice = Progress::default();
+        let bob = Progress::default();
+        let item = "minecraft:oak_planks";
+        assert_eq!(rules.missing(item, &alice).unwrap().id, "pack:a");
+        alice.grant("pack:a", "done", "");
+        assert_eq!(rules.missing(item, &alice).unwrap().id, "pack:b");
+        alice.grant("pack:b", "done", "");
+        assert!(rules.missing(item, &alice).is_none());
+        assert_eq!(rules.missing(item, &bob).unwrap().id, "pack:a");
+        assert!(rules.missing("minecraft:stone", &bob).is_none());
+        assert!(CraftingRules::load(&overlay, &tree(), |_| false).is_err());
+        assert!(CraftingRules::load(&overlay, &Tree::default(), |_| true).is_err());
+    }
+    // Menu-engine timings. Preparation and verification of each 64-craft fixture are outside the clock.
+    #[test]
+    fn quest_crafting_preview_and_bulk_timings() {
+        use crate::items::ItemStack;
+        use crate::menu::{Env, Input, Kind, Menu, tests::with_menu};
+        use std::{hint::black_box, time::Instant};
+
+        fn sample<T>(iterations: usize, mut op: impl FnMut() -> T) -> f64 {
+            for _ in 0..4 {
+                black_box(op());
+            }
+            let started = Instant::now();
+            for _ in 0..iterations {
+                black_box(black_box(&mut op)());
+            }
+            started.elapsed().as_secs_f64() * 1e9 / iterations as f64
+        }
+
+        let tree = tree();
+        let mut large = CraftingRules::default();
+        for i in 0..999 {
+            large
+                .0
+                .insert(format!("test:item_{i}"), vec![tree.list[0].clone()]);
+        }
+        large
+            .0
+            .insert("minecraft:oak_planks".into(), vec![tree.list[0].clone()]);
+        let mut progress = Progress::default();
+        progress.grant("pack:a", "done", "");
+        with_menu(Kind::Crafting, |base, preview| {
+            for (count, actor_rules) in [(0, None), (1000, Some((&large, &progress)))] {
+                let env = Env {
+                    actor_rules,
+                    ..*base
+                };
+                let log = || Some(ItemStack::new("minecraft:oak_log", 64));
+                preview.set_slot(&env, 1, log());
+                let preview_ns = sample(1000, || {
+                    preview.recompute(&env);
+                    let item = &preview.slot(0).unwrap().item;
+                    missing(env.actor_rules, black_box(item)).is_none()
+                });
+                let mut menus: Vec<_> = (0..36)
+                    .map(|_| {
+                        let mut m = Menu::new(Kind::Crafting);
+                        m.set_slot(&env, 1, log());
+                        m
+                    })
+                    .collect();
+                let mut next = menus.iter_mut();
+                let bulk_ns = sample(32, || {
+                    next.next()
+                        .unwrap()
+                        .click(&env, 0, 0, Input::QuickMove)
+                        .unwrap()
+                });
+                for m in &menus {
+                    assert!(m.slot(1).is_none());
+                    assert_eq!(m.item_crafted.len(), 64);
+                }
+                println!(
+                    "rules={count}, fresh preview {preview_ns:.0} ns, 64-craft menu transaction {bulk_ns:.0} ns"
+                );
+            }
+        });
+    }
+}
