+impl JournalCatalog {
+    fn from_tree(tree: Arc<Tree>) -> Self {
+        use std::collections::{BTreeMap, BTreeSet, HashSet, VecDeque};
+        let children = tree.children();
+        let mut roots: Vec<_> = tree.list.iter().enumerate().filter_map(|(index, a)| {
+            let config = a.display.as_ref()?.title.get("horizon:chapter_v1")?;
+            Some((config["order"].as_i64().unwrap_or(0), a.id.clone(), index))
+        }).collect();
+        roots.sort();
+        let mut chapters = Vec::new();
+        let mut members = HashSet::new();
+        for (_, _, root) in roots {
+            let config = &tree.list[root].display.as_ref().unwrap().title["horizon:chapter_v1"];
+            let explicit: BTreeMap<_, _> = config["positions"].as_object().into_iter().flatten()
+                .filter_map(|(id, xy)| Some((id.as_str(), (i32::try_from(xy[0].as_i64()?).ok()?, i32::try_from(xy[1].as_i64()?).ok()?))))
+                .collect();
+            let mut occupied: BTreeSet<_> = explicit.values().copied().collect();
+            let mut next_row = BTreeMap::<usize, usize>::new();
+            let mut queue = VecDeque::from([(root, 0usize)]);
+            let mut nodes = Vec::new();
+            while let Some((index, depth)) = queue.pop_front() {
+                if !members.insert(index) { continue; }
+                let adv = &tree.list[index];
+                if adv.display.is_some() {
+                    let xy = explicit.get(adv.id.as_str()).copied().unwrap_or_else(|| {
+                        let ordinal = next_row.entry(depth).or_default();
+                        loop {
+                            let point = auto_position(depth, *ordinal);
+                            *ordinal += 1;
+                            if occupied.insert(point) { break point; }
+                        }
+                    });
+                    nodes.push((index, xy));
+                }
+                let mut kids = children[index].clone();
+                kids.sort_by(|a,b| tree.list[*a].id.cmp(&tree.list[*b].id));
+                queue.extend(kids.into_iter().map(|child| (child, depth+1)));
+            }
+            chapters.push(ChapterView { root, nodes });
+        }
+        Self { tree, chapters, members }
+    }
+}
+#[derive(Clone, Copy, PartialEq)]
+enum ClaimState { Locked, Ready, Claimed }
+
+impl Game<'_> {
+    // Only the fixed trigger name can cross the client/server boundary.
+    fn journal_claim(&self, i: usize) -> Option<(ClaimState, String)> {
+        let quest = &self.adv.tree.list[i];
+        let title = &quest.display.as_ref()?.title;
+        let objective = title.get("horizon:claim_v1")
+            .or_else(|| title.pointer("/extra/0/horizon:claim_v1"))?.as_str()?;
+        let suffix = objective.strip_prefix("qj")?;
+        if suffix.len() != 14 || !suffix.bytes().all(|b| b.is_ascii_hexdigit()) { return None; }
+        let (ns, path) = quest.id.split_once(':')?;
+        let receipt = format!("{ns}:journal_claim/{path}/receipt");
+        let earned = format!("{ns}:journal_claim/{path}/earned");
+        let state = if !self.adv_done(i) { ClaimState::Locked }
+            else if self.adv.progress.has(&earned, "done") && !self.adv.progress.has(&receipt, "done") { ClaimState::Ready }
+            else { ClaimState::Claimed };
+        Some((state, objective.to_owned()))
+    }
+}
+impl Game<'_> {
+    fn refresh_journal(&mut self) {
+        if self.adv_ui.journal.as_ref().is_some_and(|c| Arc::ptr_eq(&c.tree, &self.adv.tree)) { return; }
+        let catalog = JournalCatalog::from_tree(self.adv.tree.clone());
+        let active = self.adv_ui.map_chapter.as_ref();
+        if !catalog.chapters.iter().any(|ch| Some(&catalog.tree.list[ch.root].id) == active) {
+            self.adv_ui.map_chapter = catalog.chapters.first().map(|ch| catalog.tree.list[ch.root].id.clone());
+            self.adv_ui.map_pan = (0.0, 0.0);
+            self.adv_ui.map_selected = None;
+        }
+        self.adv_ui.journal = Some(catalog);
+    }
+    pub(super) fn journal_member(&mut self, index: usize) -> bool {
+        self.refresh_journal();
+        self.adv_ui.journal.as_ref().is_some_and(|catalog| catalog.members.contains(&index))
+            && self.adv.tree.list[index].parent.is_some()
+    }
+    fn current_chapter(&self) -> Option<(usize, &ChapterView)> {
+        let catalog = self.adv_ui.journal.as_ref()?;
+        let id = self.adv_ui.map_chapter.as_ref()?;
+        catalog.chapters.iter().enumerate().find(|(_,ch)| &catalog.tree.list[ch.root].id == id)
+    }
+    fn journal_xy(&self, w: f32, h: f32, dx: i32, dy: i32) -> (f32, f32) {
+        let fold = (w * 0.5).floor();
+        let scale = ((fold - 42.0) / 255.0).min((h - 79.0) / 158.0).clamp(0.30, 1.8);
+        ((fold + 11.0) * 0.5 + self.adv_ui.map_pan.0 + dx as f32 * scale,
+         h * 0.51 + self.adv_ui.map_pan.1 + dy as f32 * scale)
+    }
+
+    fn journal_hit(&self, w: f32, h: f32) -> Option<usize> {
+        if self.cursor.0 < 15.0 || self.cursor.0 >= (w*0.5).floor()-4.0 || self.cursor.1 < 30.0 || self.cursor.1 >= h-24.0 { return None; }
+        let (_, chapter) = self.current_chapter()?;
+        chapter.nodes.iter().find_map(|&(index,(dx,dy))| {
+            let (x,y) = self.journal_xy(w,h,dx,dy);
+            if self.adv.tree.list[index].display.as_ref().is_some_and(|d| d.hidden && !self.adv_done(index)) { return None; }
+            let radius = if index == chapter.root { 15.0 } else { 11.0 };
+            ((self.cursor.0-x).hypot(self.cursor.1-y) <= radius).then_some(index)
+        })
+    }
+
+    fn draw_journal(&mut self, batch: &mut HudBatch) {
