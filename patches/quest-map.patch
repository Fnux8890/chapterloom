+struct JournalCatalog {
+    tree: Arc<Tree>,
+    chapters: Vec<ChapterView>,
+    members: std::collections::HashSet<usize>,
+}
+
+
+fn auto_position(depth: usize, ordinal: usize) -> (i32, i32) {
+    const COLUMN_SPACING: i32 = 50;
+    const ROW_SPACING: i32 = 32;
+
+    let x = i32::try_from(depth)
+        .unwrap_or(i32::MAX)
+        .saturating_mul(COLUMN_SPACING);
+
+    let y = if ordinal == 0 {
+        0
+    } else if ordinal % 2 == 1 {
+        let step = i32::try_from(ordinal / 2 + 1).unwrap_or(i32::MAX);
+        step.saturating_mul(ROW_SPACING)
+    } else {
+        let step = i32::try_from(ordinal / 2).unwrap_or(i32::MAX);
+        step.saturating_mul(-ROW_SPACING)
+    };
+
+    (x, y)
+}
